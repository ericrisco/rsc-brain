# rsc-brain production env contract (SPEC-18). Copy to deploy/.env (or let init-secrets.sh
# generate it) for the raw compose target. Coolify/Dokploy set the same contract in their UI.
# Coolify additionally generates SERVICE_PASSWORD_POSTGRES; POSTGRES_PASSWORD must contain the exact
# same value because Compose interpolates the canonical file before merging the platform overlay.

# --- required database secret ---
POSTGRES_USER=rsc_brain
POSTGRES_DB=rsc_brain
POSTGRES_PASSWORD=            # a strong unique password; the app DSN derives from it

# Override only for an EXTERNAL database (otherwise derived from POSTGRES_PASSWORD):
# RSC_BRAIN_DATABASE__DSN=postgresql+asyncpg://user:pass@host:5432/rsc_brain

# --- TLS + public origin ---
RSC_BRAIN_DOMAIN=localhost     # public hostname only; Caddy serves automatic HTTPS
# Also set RSC_BRAIN_INGRESS__PUBLIC_ORIGIN=https://<same-hostname> and inject it into api/worker
# through the private Compose override documented in deploy/README.md.

# --- first admin (created once by `brain init`) ---
RSC_BRAIN_ADMIN_EMAIL=admin@rsc-brain.local
RSC_BRAIN_ADMIN_PASSWORD=       # required for Compose: migrate has no persistent credential mount

# --- model gateway ---
# AppConfig requires extractor, judge, topicalizer, embedder, and reranker. The canonical Compose
# passes only the embedder variables below. Add all five routes to api + worker with a private
# Compose override as documented in deploy/README.md; host variables not declared there are ignored.
RSC_BRAIN_CAPABILITIES__EMBEDDER__PROVIDER=ollama
RSC_BRAIN_CAPABILITIES__EMBEDDER__MODEL=bge-m3
RSC_BRAIN_CAPABILITIES__EMBEDDER__API_BASE=http://model-host:11434
