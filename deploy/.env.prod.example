# rsc-brain production env contract (SPEC-18). Copy to deploy/.env (or let init-secrets.sh
# generate it) for the raw compose target. Coolify/Dokploy inject these via their own UI/magic env.

# --- required secret (the ONLY one) ---
POSTGRES_USER=rsc_brain
POSTGRES_DB=rsc_brain
POSTGRES_PASSWORD=            # a strong unique password; the app DSN derives from it

# Override only for an EXTERNAL database (otherwise derived from POSTGRES_PASSWORD):
# RSC_BRAIN_DATABASE__DSN=postgresql+asyncpg://user:pass@host:5432/rsc_brain

# --- TLS + domain (hard OAuth prereq, FR-4.8/D11) ---
RSC_BRAIN_DOMAIN=localhost     # your public domain → Caddy serves automatic HTTPS

# --- first admin (created once by `brain init`; password shown in logs if omitted) ---
RSC_BRAIN_ADMIN_EMAIL=admin@rsc-brain.local
RSC_BRAIN_ADMIN_PASSWORD=

# --- model gateway (per capability: extractor|judge|topicalizer|embedder|reranker) ---
RSC_BRAIN_CAPABILITIES__EMBEDDER__PROVIDER=ollama
RSC_BRAIN_CAPABILITIES__EMBEDDER__MODEL=nomic-embed-text
RSC_BRAIN_CAPABILITIES__EMBEDDER__API_BASE=http://ollama:11434
