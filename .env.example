# rsc-brain — Compose / data-service environment. Copy to `.env` and fill in.
# `.env` is gitignored; only this example is tracked. NEVER commit real secrets.

# --- Data service (Postgres 16 + AGE + pgvector) ---
POSTGRES_USER=rsc_brain
POSTGRES_DB=rsc_brain
# REQUIRED. Set a strong, unique password (>=16 chars). Startup refuses blanks and known
# placeholders. Generate one, e.g.:  openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Host bindings for published ports ---
# Loopback-only by default. Change to 0.0.0.0 ONLY if you understand the exposure and have
# put the service behind a trusted network / proxy.
RSC_BRAIN_DB_BIND=127.0.0.1
RSC_BRAIN_DB_PORT=5432
RSC_BRAIN_OLLAMA_BIND=127.0.0.1
RSC_BRAIN_VLLM_BIND=127.0.0.1
