{
  "name": "@ericrisco/rsc-brain",
  "version": "0.2.0",
  "description": "Self-hosted knowledge server for AI agents: a journal agents write freely, a wiki people approve, searchable over MCP and HTTP.",
  "license": "MIT",
  "author": "Eric Risco",
  "type": "module",
  "private": true,
  "bin": {
    "rsc-brain": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "engines": {
    "node": ">=25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericrisco/rsc-brain.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p tsconfig.browser.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'",
    "test:web": "playwright test -c playwright.config.ts",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "test:install": "RSC_BRAIN_INSTALL_TESTS=1 node --test --test-reporter=spec 'test/install/**/*.test.ts'",
    "web:dev": "vite --config web/vite.config.ts",
    "verify": "bash scripts/verify.sh",
    "pg:start": "bash scripts/pg-test.sh start",
    "pg:stop": "bash scripts/pg-test.sh stop"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "diff": "9.0.0",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "preact": "10.29.8",
    "preact-iso": "2.12.2",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@types/node": "25.9.9",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "markdown-it": "15.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
